tryDy=0;entryPerimeter=0;" edge="1" parent="1" source="2 g18" target="2 g32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="490"/><mxPoint x="1580" y="280"/></Array></mxGeometry></mxCell><mxCell id="2 g52" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;• Only the load balancer is public: Cloud Armor in front, Kong accepts only Google's front ends, every service is internal (ClusterIP).&lt;br&gt;• Default-deny network policies per namespace; pods run non-root with a read-only root filesystem and CPU and memory limits.&lt;br&gt;• Workload Identity: a Google account per role and no Google keys; GitHub deploys through Workload Identity Federation. The one outside key, Anthropic's, sits in Secret Manager.&lt;br&gt;• Binary Authorization enforces: only images CI signed (cosign, SBOM attached) can run." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="890" width="1240" height="120" as="geometry"/></mxCell><mxCell id="2 g53" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1640" y="760" width="220" height="232" as="geometry"/></mxCell><mxCell id="2 g54" value="Front door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="792" width="190" height="26" as="geometry"/></mxCell><mxCell id="2 g55" value="Internal service (via Kong)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="824" width="190" height="26" as="geometry"/></mxCell><mxCell id="2 g56" value="Private worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="856" width="190" height="26" as="geometry"/></mxCell><mxCell id="2 g57" value="Pub/Sub topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="888" width="190" height="26" as="geometry"/></mxCell><mxCell id="2 g58" value="Data store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="920" width="190" height="26" as="geometry"/></mxCell><mxCell id="2 g59" value="Outside service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1650" y="952" width="190" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="3-life-of-a-document" name="3 Life of a document"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3 l1" value="Life of a document: upload → analyze → approve → detect → case analysis" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="3 l2" value="&lt;b&gt;Officer (UI)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="170" height="1240" as="geometry"/></mxCell><mxCell id="3 l3" value="&lt;b&gt;Kong + api&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="170" height="1240" as="geometry"/></mxCell><mxCell id="3 l4" value="&lt;b&gt;Pub/Sub&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="170" height="1240" as="geometry"/></mxCell><mxCell id="3 l5" value="&lt;b&gt;doc-worker&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="80" width="170" height="1240" as="geometry"/></mxCell><mxCell id="3 l6" value="&lt;b&gt;detection-worker&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="900" y="80" width="170" height="1240" as="geometry"/></mxCell><mxCell id="3 l7" value="&lt;b&gt;case-worker&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1110" y="80" width="170" height="1240" as="geometry"/></mxCell><mxCell id="3 l8" value="&lt;b&gt;audit-metrics&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1320" y="80" width="170" height="1240" as="geometry"/></mxCell><mxCell id="3 l9" value="&lt;b&gt;Supabase&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1530" y="80" width="170" height="1240" as="geometry"/></mxCell><mxCell id="3 l10" value="1. upload file(s)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="170" as="sourcePoint"/><mxPoint x="355" y="170" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l11" value="2. store file, document row = queued" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="222" as="sourcePoint"/><mxPoint x="1615" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l12" value="3. publish document.uploaded" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="274" as="sourcePoint"/><mxPoint x="565" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l13" value="4. pulled (its own filtered subscription)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="326" as="sourcePoint"/><mxPoint x="775" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l14" value="5. claim queued→processing (compare-and-swap); classify, extract; = analyzed" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="378" as="sourcePoint"/><mxPoint x="1615" y="378" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l15" value="6. publish document.analyzed (+ Claude cost)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="430" as="sourcePoint"/><mxPoint x="565" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l16" value="7. every event stored once in audit_events" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="482" as="sourcePoint"/><mxPoint x="1405" y="482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l17" value="8. Realtime: the document row changed" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1615" y="534" as="sourcePoint"/><mxPoint x="355" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l18" value="9. fresh snapshot over the WebSocket" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="586" as="sourcePoint"/><mxPoint x="145" y="586" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l19" value="10. review fields, approve" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="638" as="sourcePoint"/><mxPoint x="355" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l20" value="11. status = approved (compare-and-swap)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="690" as="sourcePoint"/><mxPoint x="1615" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l21" value="12. publish document.approved (if it fails, step 11 is undone)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="742" as="sourcePoint"/><mxPoint x="565" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l22" value="13. pulled" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="794" as="sourcePoint"/><mxPoint x="985" y="794" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l23" value="14. = detecting; lead + specialists + checks; flags; = detected" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="846" as="sourcePoint"/><mxPoint x="1615" y="846" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l24" value="15. publish document.detected (+ Claude cost)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="898" as="sourcePoint"/><mxPoint x="565" y="898" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l25" value="16. last approved document scanned: record a running analysis run" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="950" as="sourcePoint"/><mxPoint x="1615" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l26" value="17. publish case.analysis.requested (by the system)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="1002" as="sourcePoint"/><mxPoint x="565" y="1002" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l27" value="18. pulled" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="1054" as="sourcePoint"/><mxPoint x="1195" y="1054" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l28" value="19. cross-document findings, risk score, summary" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="1106" as="sourcePoint"/><mxPoint x="1615" y="1106" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l29" value="20. publish case.analysis.completed (+ Claude cost)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="1158" as="sourcePoint"/><mxPoint x="565" y="1158" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l30" value="21. Realtime: the analysis run finished" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1615" y="1210" as="sourcePoint"/><mxPoint x="355" y="1210" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l31" value="22. live update: score and findings appear" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="1262" as="sourcePoint"/><mxPoint x="145" y="1262" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l32" value="One trace in Cloud Trace covers steps 1-6 and 10-15: the traceparent travels on each Pub/Sub message. Dashed arrows are live updates. A worker that dies mid-run never acknowledges its message, so Pub/Sub redelivers it; work stuck past its limit is recovered by the sweeper (page 4)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1340" width="1500" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4-stuck-work-recovery" name="4 Stuck work recovery"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="920" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4 s1" value="Recovering stuck work (no database changes; the audit trail is the memory)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="4 s2" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;every 5 minutes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="170" height="80" as="geometry"/></mxCell><mxCell id="4 s3" value="&lt;b&gt;domain-events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;type = sweep.requested&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="270" y="215" width="170" height="100" as="geometry"/></mxCell><mxCell id="4 s4" value="&lt;b&gt;Sweeper (in audit-metrics)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;finds work past its limit:&lt;br&gt;queued/uploaded &amp;gt; 5 min (event lost)&lt;br&gt;processing/extracting/detecting &amp;gt; 10 min&lt;br&gt;case analysis running &amp;gt; 15 min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="540" y="185" width="280" height="160" as="geometry"/></mxCell><mxCell id="4 s5" value="&lt;b&gt;Supabase&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;documents, runs&lt;br&gt;audit_events (earlier attempts)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="580" y="430" width="200" height="90" as="geometry"/></mxCell><mxCell id="4 s6" value="&lt;b&gt;domain-events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;the same topic, not a new one&lt;br&gt;&lt;br&gt;type = recovery.requested&lt;br&gt;&lt;br&gt;subscriptions filter on&lt;br&gt;attribute owner = the worker&lt;br&gt;&lt;br&gt;attempt n of 3,&lt;br&gt;a full limit apart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="920" y="100" width="180" height="330" as="geometry"/></mxCell><mxCell id="4 s7" value="Owning workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1280" y="60" width="320" height="390" as="geometry"/></mxCell><mxCell id="4 s8" value="&lt;b&gt;doc-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reset to queued (CAS), rerun&lt;br&gt;after 3 tries: failed → officer can Retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="100" width="280" height="90" as="geometry"/></mxCell><mxCell id="4 s9" value="owner = doc-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.1364;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4 s6" target="4 s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s10" value="&lt;b&gt;detection-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reset to approved (CAS), rerun&lt;br&gt;after 3 tries: approved with error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="220" width="280" height="90" as="geometry"/></mxCell><mxCell id="4 s11" value="owner = detection-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4 s6" target="4 s10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s12" value="&lt;b&gt;case-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;mark the run failed (no rerun:&lt;br&gt;costs Claude calls, officer decides)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1300" y="340" width="280" height="90" as="geometry"/></mxCell><mxCell id="4 s13" value="owner = case-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.8636;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4 s6" target="4 s12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s14" value="&lt;b&gt;Outcome events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;document.recovered · recovery.exhausted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1300" y="520" width="280" height="70" as="geometry"/></mxCell><mxCell id="4 s15" value="&lt;b&gt;Seen in&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;audit trail · Pipeline dashboard (stuck now,&lt;br&gt;recovered, gave up) · email alert on give-up&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1300" y="650" width="280" height="80" as="geometry"/></mxCell><mxCell id="4 s16" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4 s2" target="4 s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s17" value="pulled" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4 s3" target="4 s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s18" value="read only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4 s4" target="4 s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s19" value="publish one&lt;br&gt;per stuck item" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4 s4" target="4 s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s20" value="each publishes its outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4 s7" target="4 s14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="4 s14" target="4 s15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s22" value="&lt;b&gt;Also handled&lt;/b&gt;&lt;br&gt;• Worker dies mid-run → its message is never acknowledged, so Pub/Sub redelivers it; after 5 attempts → dead-letter + email alert.&lt;br&gt;• A pod being replaced finishes its current run first (up to 10 minutes' grace) and takes no new events.&lt;br&gt;• Officer cancels a run on another instance → the run polls the audit trail / its status every 5 s and stops.&lt;br&gt;• Publishing an approval fails → the approval is undone and the officer sees an error (nothing left half-done)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1000" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5-observability-and-cost" name="5 Observability and cost"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5 o1" value="Observability: metrics, traces, audit trail and cost" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="5 o2" value="&lt;b&gt;Kong&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;status codes, latency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="280" height="60" as="geometry"/></mxCell><mxCell id="5 o3" value="&lt;b&gt;Every backend service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;GET /metrics (prometheus_client)&lt;br&gt;requests · events · stage timings&lt;br&gt;Claude calls/tokens/cost/latency per agent&lt;br&gt;cost per document · tool outcomes · stuck work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="280" height="150" as="geometry"/></mxCell><mxCell id="5 o4" value="&lt;b&gt;Managed Prometheus&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;a PodMonitoring per namespace&lt;br&gt;scrapes /metrics every 30 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="410" y="90" width="210" height="250" as="geometry"/></mxCell><mxCell id="5 o5" value="&lt;b&gt;Cloud Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Managed Prometheus +&lt;br&gt;GKE, load balancer and&lt;br&gt;Pub/Sub metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="690" y="170" width="220" height="90" as="geometry"/></mxCell><mxCell id="5 o6" value="&lt;b&gt;Alert policies → email&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;dead letters · 5xx &amp;gt; 5%&lt;br&gt;Claude spend/day · recovery gave up&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1080" y="60" width="240" height="80" as="geometry"/></mxCell><mxCell id="5 o7" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Services · Pipeline · Agents · Cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1080" y="170" width="240" height="90" as="geometry"/></mxCell><mxCell id="5 o8" value="&lt;b&gt;BigQuery billing export&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;actual invoice lines&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="690" y="310" width="220" height="80" as="geometry"/></mxCell><mxCell id="5 o9" value="&lt;b&gt;Cloud Trace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;one trace per upload, across services&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="280" height="70" as="geometry"/></mxCell><mxCell id="5 o10" value="&lt;b&gt;audit_events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;every action;&lt;br&gt;each run's Claude cost&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="410" y="450" width="210" height="80" as="geometry"/></mxCell><mxCell id="5 o11" value="&lt;b&gt;audit-metrics&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;sums each run's cost&lt;br&gt;per document and case&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="690" y="450" width="220" height="80" as="geometry"/></mxCell><mxCell id="5 o12" value="&lt;b&gt;App: Claude Cost tab&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;per case and per document&lt;br&gt;GET /audit/cases/{id}/cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1080" y="450" width="240" height="80" as="geometry"/></mxCell><mxCell id="5 o13" value="scraped&lt;br&gt;(pull)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.1200;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="5 o2" target="5 o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o14" value="scraped&lt;br&gt;(pull)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.7000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="5 o3" target="5 o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o15" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="5 o4" target="5 o5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o16" value="PromQL conditions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="5 o5" target="5 o6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="100"/></Array></mxGeometry></mxCell><mxCell id="5 o17" value="PromQL (query proxy)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="5 o5" target="5 o7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o18" value="SQL (BigQuery plugin)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="5 o8" target="5 o7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1200" y="350"/></Array></mxGeometry></mxCell><mxCell id="5 o19" value="OpenTelemetry spans" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="5 o3" target="5 o9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o20" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="5 o10" target="5 o11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o21" value="GET /audit/cases/&lt;br&gt;{id}/cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="5 o11" target="5 o12"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6-ci-and-deploy" name="6 CI and deploy"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6 c1" value="Delivery: CI on every push and PR; a green push to main deploys (GitHub Actions → Cloud Deploy)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1300" height="40" as="geometry"/></mxCell><mxCell id="6 c2" value="&lt;b&gt;git push / PR&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ci-cd.yml&lt;br&gt;a docs-only push is skipped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="160" height="70" as="geometry"/></mxCell><mxCell id="6 c3" value="&lt;b&gt;All three green?&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;only a push to main deploys;&lt;br&gt;a PR or branch stops here&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="740" y="250" width="190" height="70" as="geometry"/></mxCell><mxCell id="6 c4" value="&lt;b&gt;Backend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;ruff · pyright (no suppressions)&lt;br&gt;pytest + coverage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="110" width="380" height="80" as="geometry"/></mxCell><mxCell id="6 c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="6 c2" target="6 c4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="285"/><mxPoint x="235" y="150.0"/></Array></mxGeometry></mxCell><mxCell id="6 c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="6 c4" target="6 c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="695" y="150.0"/><mxPoint x="695" y="285"/></Array></mxGeometry></mxCell><mxCell id="6 c7" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;lint · tsc · build&lt;br&gt;Playwright on the production build&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="210" width="380" height="80" as="geometry"/></mxCell><mxCell id="6 c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="6 c2" target="6 c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="285"/><mxPoint x="235" y="250.0"/></Array></mxGeometry></mxCell><mxCell id="6 c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="6 c7" target="6 c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="695" y="250.0"/><mxPoint x="695" y="285"/></Array></mxGeometry></mxCell><mxCell id="6 c10" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Checkov · pip-audit · npm audit (blocking)&lt;br&gt;Snyk · Terraform fmt + validate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="270" y="310" width="380" height="80" as="geometry"/></mxCell><mxCell id="6 c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="6 c2" target="6 c10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="235" y="285"/><mxPoint x="235" y="350.0"/></Array></mxGeometry></mxCell><mxCell id="6 c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="6 c10" target="6 c3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="695" y="350.0"/><mxPoint x="695" y="285"/></Array></mxGeometry></mxCell><mxCell id="6 c13" value="&lt;b&gt;Helm chart (helm.yml, on chart changes)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;values generated from roles.json · render · Checkov&lt;br&gt;on kind: Pub/Sub emulator, one event per worker, a call the policies must block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1000" y="110" width="420" height="80" as="geometry"/></mxCell><mxCell id="6 c14" value="deploy.yml · one deploy at a time, never cancelled halfway (that would skip the rollback)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="220" y="540" width="1560" height="380" as="geometry"/></mxCell><mxCell id="6 c15" value="&lt;b&gt;Run workflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;manual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="160" height="60" as="geometry"/></mxCell><mxCell id="6 c16" value="&lt;b&gt;Authenticate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Workload Identity Federation&lt;br&gt;short-lived tokens, no keys&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="240" y="590" width="200" height="90" as="geometry"/></mxCell><mxCell id="6 c17" value="&lt;b&gt;Build 8 images&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;5 role targets of one Dockerfile + Kong,&lt;br&gt;frontend, Grafana&lt;br&gt;skipped if this commit's image exists&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="490" y="590" width="240" height="90" as="geometry"/></mxCell><mxCell id="6 c18" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;scanned on push&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="780" y="605" width="170" height="60" as="geometry"/></mxCell><mxCell id="6 c19" value="&lt;b&gt;Sign and attest&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;cosign signature + SBOM (syft)&lt;br&gt;Binary Authorization attestation&lt;br&gt;(one Cloud KMS key)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="590" width="260" height="90" as="geometry"/></mxCell><mxCell id="6 c20" value="&lt;b&gt;Render the chart&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Helm, images by digest&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1000" y="740" width="170" height="80" as="geometry"/></mxCell><mxCell id="6 c21" value="&lt;b&gt;Cloud Deploy release&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;rolls out to GKE&lt;br&gt;(recorded)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="1200" y="740" width="180" height="80" as="geometry"/></mxCell><mxCell id="6 c22" value="&lt;b&gt;Verify&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;gateway checks through&lt;br&gt;the load balancer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1410" y="740" width="170" height="80" as="geometry"/></mxCell><mxCell id="6 c23" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;release recorded&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1610" y="734" width="150" height="60" as="geometry"/></mxCell><mxCell id="6 c24" value="&lt;b&gt;Roll back&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;to the newest release&lt;br&gt;that rolled out fine&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1610" y="840" width="150" height="60" as="geometry"/></mxCell><mxCell id="6 c25" value="green push to main" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;ent