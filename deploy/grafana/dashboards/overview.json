  "panels": [
    {
      "type": "row",
      "title": "Is it up and keeping its promises",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Site reachable",
      "description": "Share of the uptime checks (Asia, Europe, US, every 5 minutes) that reached sixsevens.me and the API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(avg by (host) (monitoring_googleapis_com:uptime_check_check_passed{monitored_resource=\"uptime_url\"}))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "API success, 28 days",
      "description": "Objective 99% (Cloud Monitoring SLO).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(http_requests_total{namespace=\"api\",route!=\"/health\",status=~\"5..\"}[28d])) / clamp_min(sum(increase(http_requests_total{namespace=\"api\",route!=\"/health\"}[28d])), 1))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Detection within 3 min, 28 days",
      "description": "Objective 95% (Cloud Monitoring SLO).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(stage_duration_seconds_bucket{stage=\"document.detected\",le=\"180.0\"}[28d])) / clamp_min(sum(increase(stage_duration_seconds_count{stage=\"document.detected\"}[28d])), 1)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 5
      }
    },
    {
      "type": "stat",
      "title": "Cases analysed",
