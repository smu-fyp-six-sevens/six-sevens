0" width="160" height="60" as="geometry"/></mxCell><mxCell id="2 g18" value="&lt;b&gt;case-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;private&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="680" y="540" width="160" height="60" as="geometry"/></mxCell><mxCell id="2 g19" value="&lt;b&gt;grafana&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;+ Prometheus query proxy sidecar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="860" y="640" width="150" height="70" as="geometry"/></mxCell><mxCell id="2 g20" value="&lt;b&gt;Pub/Sub&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;domain-events + dead-letter&lt;br&gt;4 filtered push subscriptions&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;direction=south;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1060" y="340" width="180" height="90" as="geometry"/></mxCell><mxCell id="2 g21" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;sweep every 2 min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="1060" y="460" width="180" height="60" as="geometry"/></mxCell><mxCell id="2 g22" value="&lt;b&gt;Artifact Registry&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;one image per role + build cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="1270" y="300" width="180" height="70" as="geometry"/></mxCell><mxCell id="2 g23" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;keys, readable only by&lt;br&gt;the services that need them&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="1270" y="400" width="180" height="70" as="geometry"/></mxCell><mxCell id="2 g24" value="&lt;b&gt;Cloud Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Managed Prometheus · alert policies&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="1060" y="560" width="180" height="70" as="geometry"/></mxCell><mxCell id="2 g25" value="&lt;b&gt;Cloud Trace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;OpenTelemetry spans&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="1060" y="660" width="180" height="60" as="geometry"/></mxCell><mxCell id="2 g26" value="&lt;b&gt;BigQuery&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;billing_export.costs&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1270" y="560" width="180" height="60" as="geometry"/></mxCell><mxCell id="2 g27" value="&lt;b&gt;IAM + Workload Identity Federation&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;github-deployer · pubsub-push · run-*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="1270" y="660" width="180" height="70" as="geometry"/></mxCell><mxCell id="2 g28" value="&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;• Workers can be invoked only by the pubsub-push identity (OIDC); audit-metrics checks it in code.&lt;br&gt;• No long-lived keys: GitHub deploys through Workload Identity Federation.&lt;br&gt;• Secrets come from Secret Manager per service; Grafana has its own login." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="800" width="760" height="100" as="geometry"/></mxCell><mxCell id="2 g29" va