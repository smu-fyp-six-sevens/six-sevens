          "expr": "((sum(increase(llm_cost_usd_total[$__range]))) or vector(0)) + ((sum(increase(run_googleapis_com:container_cpu_allocation_time{monitored_resource=\"cloud_run_revision\"}[$__range]))) or vector(0)) * $cpu_price + ((sum(increase(run_googleapis_com:container_memory_allocation_time{monitored_resource=\"cloud_run_revision\"}[$__range]))) or vector(0)) * $mem_price + ((sum(increase(run_googleapis_com:request_count{monitored_resource=\"cloud_run_revision\"}[$__range]))) or vector(0)) * $req_price + ((sum(increase(pubsub_googleapis_com:topic_byte_cost[$__range]))) or vector(0)) / 1099511627776 * $pubsub_price",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
