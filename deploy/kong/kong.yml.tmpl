# Kong DB-less routes (CLOUD_ARCHITECTURE_PLAN.md section 4), rendered by render.sh at start.
# Rate limits count per Kong instance (policy: local): login and upload per client address (render.sh sets the
# real-IP header), the token-spending routes per officer (their bearer token).
# ${API_URL}, ${AUDIT_URL}: upstreams (http://api:8000 locally, https://<service>.run.app on Cloud Run).
# ${PRESERVE_HOST}: false on Cloud Run, which routes by Host. ${CORS_ORIGINS}: the frontend origins, quoted.
# ${GATEWAY_SECRET}: the shared secret the upstreams check (Secret Manager on Cloud Run; a fixed value in compose).
_format_version: "3.0"

services:
  - name: api
    url: ${API_URL}
    # Long enough for the case WebSocket and slow uploads.
    read_timeout: 3600000
    write_timeout: 3600000
    routes:
      - name: api
        paths: ["/"]
        strip_path: false
        preserve_host: ${PRESERVE_HOST}
      - name: login
        paths: ["/auth/login"]
        strip_path: false
        preserve_host: ${PRESERVE_HOST}
        plugins:
          - name: rate-limiting
            config: { minute: 20, policy: local }
      - name: upload
        paths: ["/documents/upload-batch"]
        strip_path: false
        preserve_host: ${PRESERVE_HOST}
        plugins:
          - name: rate-limiting
            config: { minute: 60, policy: local }
      # Routes that spend Claude tokens: limited per officer (their token), so a stolen token can't loop them.
      - name: token-spending
        paths:
          - "~/documents/[^/]+/retry$"
          - "~/documents/[^/]+/detection/retry$"
          - "~/documents/[^/]+/document-type$"
          - "~/cases/[^/]+/analysis/run$"
        methods: [POST, PATCH]
        regex_priority: 10
        strip_path: false
        preserve_host: ${PRESERVE_HOST}
        plugins:
          - name: rate-limiting
            config: { minute: 10, hour: 60, policy: local, limit_by: header, header_name: Authorization }
      # The on-demand checks (routers/detection.py); some run vision.
      - name: on-demand-checks
        paths: ["~/documents/[^/]+/detection/[a-z-]+$"]
        methods: [GET]
        regex_priority: 5
        strip_path: false
        preserve_host: ${PRESERVE_HOST}
        plugins:
          - name: rate-limiting
            config: { minute: 30, hour: 300, policy: local, limit_by: header, header_name: Authorization }
      # Workers' push endpoints and every service's metrics are never reachable through the gateway.
      - name: internal-only
        paths: ["/push", "/metrics"]
        plugins:
          - name: request-termination
            config: { status_code: 404, message: "Not found" }

  - name: audit-metrics
    url: ${AUDIT_URL}
    routes:
      - name: audit
        paths: ["/audit"]
        strip_path: false
        preserve_host: ${PRESERVE_HOST}

plugins:
  - name: cors
    config:
      origins: [${CORS_ORIGINS}]
      methods: [GET, POST, PUT, PATCH, DELETE, OPTIONS]
      headers: [Authorization, Content-Type, X-Request-ID]
      exposed_headers: [X-Request-ID, Content-Disposition]
      credentials: true
      max_age: 600
  - name: correlation-id
    config: { header_name: X-Request-ID, generator: uuid, echo_downstream: true }
  # Proves to api and audit-metrics that a request came through here: they refuse any without it (backend
  # app/gateway.py). A client's own copy of the header is dropped first.
  - name: request-transformer
    config:
      remove: { headers: [X-Gateway-Key] }
      add: { headers: ["X-Gateway-Key:${GATEWAY_SECRET}"] }
  # Served on the status port (8100), scraped by the collector sidecar; off by default in Kong 3.
  - name: prometheus
    config: { status_code_metrics: true, latency_metrics: true, bandwidth_metrics: true }
