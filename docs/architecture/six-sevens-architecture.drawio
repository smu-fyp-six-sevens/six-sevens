        <mxCell id="4 s1" parent="1" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" value="Recovering stuck work (no database changes; the audit trail is the memory)" vertex="1">
          <mxGeometry height="40" width="1200" x="40" y="20" as="geometry" />
