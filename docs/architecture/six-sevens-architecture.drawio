    <diagram id="4-stuck-work-recovery" name="4 Stuck work recovery">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="920" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="4 s1" value="Recovering stuck work (no database changes; the audit trail is the memory)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="4 s2" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;every 5 minutes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="225" width="170" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="4 s3" value="&lt;b&gt;domain-events&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;type = sweep.requested&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
                    <mxGeometry x="270" y="215" width="170" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="4 s4" value="&lt;b&gt;Sweeper (in audit-metrics)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;finds work past its limit:&lt;br&gt;queued/uploaded &amp;gt; 5 min (event lost)&lt;br&gt;processing/extracting/detecting &amp;gt; 15 min&lt;br&gt;case analysis running &amp;gt; 15 min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
                    <mxGeometry x="540" y="185" width="280" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="4 s5" value="&lt;b&gt;Supabase&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;documents, runs&lt;br&gt;audit_events (earlier attempts)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="580" y="430" width="200" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="4 s6" value="&lt;b&gt;domain-events&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;the same topic, not a new one&lt;br&gt;&lt;br&gt;type = recovery.requested&lt;br&gt;&lt;br&gt;subscriptions filter on&lt;br&gt;attribute owner = the worker&lt;br&gt;&lt;br&gt;attempt n of 3,&lt;br&gt;a full limit apart&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
                    <mxGeometry x="920" y="100" width="180" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="4 s7" value="Owning workers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1">
                    <mxGeometry x="1280" y="60" width="320" height="390" as="geometry"/>
                </mxCell>
                <mxCell id="4 s8" value="&lt;b&gt;doc-worker&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;reset to queued (CAS), rerun&lt;br&gt;after 3 tries: failed → officer can Retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
