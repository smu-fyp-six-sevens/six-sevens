{
  "uid": "six-status",
  "title": "Six Sevens \u00b7 Status",
  "description": "Is it up, and is it meeting its objectives: uptime checks and the two SLOs.",
  "tags": [
    "six-sevens"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "title": "Status",
      "url": "/d/six-status",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Services",
      "url": "/d/six-services",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Pipeline",
      "url": "/d/six-pipeline",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Agents",
      "url": "/d/six-agents",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Cost",
      "url": "/d/six-cost",
      "type": "link",
      "icon": "dashboard"
    },
    {
      "title": "Traces (Cloud Trace)",
      "url": "https://console.cloud.google.com/traces/explorer",
      "type": "link",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Up now (uptime checks from Asia, Europe and the US, every 5 minutes)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "bargauge",
      "title": "Regions passing, by host",
      "description": "1 means every region reached it on its last check.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (host) (monitoring_googleapis_com:uptime_check_check_passed{monitored_resource=\"uptime_url\"})",
          "legendFormat": "{{host}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Checks passing over time",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (host) (monitoring_googleapis_com:uptime_check_check_passed{monitored_resource=\"uptime_url\"})",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 6
      }
    },
    {
      "type": "row",
      "title": "Service-level objectives (28 days, as Cloud Monitoring's SLO page counts them)",
      "collapsed": false,
      "panels": [],
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "API requests succeeding (objective 99%)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(http_requests_total{namespace=\"api\",route!=\"/health\",status=~\"5..\"}[28d])) / clamp_min(sum(increase(http_requests_total{namespace=\"api\",route!=\"/health\"}[28d])), 1))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "API error budget left",
      "description": "Share of the 1% allowance not yet used. Below 0: the objective is missed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (sum(increase(http_requests_total{namespace=\"api\",route!=\"/health\",status=~\"5..\"}[28d])) / clamp_min(sum(increase(http_requests_total{namespace=\"api\",route!=\"/health\"}[28d])), 1)) / 0.01",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 6,
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Detection runs within 3 minutes (objective 95%)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(stage_duration_seconds_bucket{stage=\"document.detected\",le=\"180.0\"}[28d])) / clamp_min(sum(increase(stage_duration_seconds_count{stage=\"document.detected\"}[28d])), 1)",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Detection error budget left",
      "description": "Share of the 5% allowance not yet used.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - (1 - sum(increase(stage_duration_seconds_bucket{stage=\"document.detected\",le=\"180.0\"}[28d])) / clamp_min(sum(increase(stage_duration_seconds_count{stage=\"document.detected\"}[28d])), 1)) / 0.05",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 8,
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "API burn rate (1 h)",
      "description": "1 spends the budget exactly over 28 days; the alert fires above 14.4 for an hour or 6 for six hours.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{namespace=\"api\",route!=\"/health\",status=~\"5..\"}[1h])) / clamp_min(sum(rate(http_requests_total{namespace=\"api\",route!=\"/health\"}[1h])), 1e-9)) / 0.01",
          "legendFormat": "burn rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "text",
      "title": "Where else",
      "options": {
        "mode": "markdown",
        "content": "The same objectives, with their history and error budget, are on Cloud Monitoring's **SLOs** page (service \"Six Sevens\"). An uptime check failing from more than one region for 10 minutes, or either SLO burning too fast, emails the alert address."
      },
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      }
    }
  ]
