            "type": "grafana-bigquery-datasource",
            "uid": "bigquery"
          },
          "rawSql": "SELECT SUM(net_cost) AS billed FROM billing_export.costs WHERE invoice_month = FORMAT_DATE('%Y%m', CURRENT_DATE())",
          "format": 1,
          "rawQuery": true,
