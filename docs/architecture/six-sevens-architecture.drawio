<mxfile host="app.diagrams.net" type="device"><diagram id="1-system-architecture" name="1 System architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1 s1" value="Six Sevens: event-driven services (Stage 1, Cloud Run)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="1 s2" value="Loan officer&lt;br&gt;&lt;font style='font-size:10px'&gt;browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="120" height="60" as="geometry"/></mxCell><mxCell id="1 s3" value="&lt;b&gt;Frontend&lt;/b&gt;&lt;br&gt;React + Vite, served by nginx&lt;br&gt;&lt;font style='font-size:10px'&gt;static build, VITE_API_URL = Kong&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="405" width="170" height="90" as="geometry"/></mxCell><mxCell id="1 s4" value="&lt;b&gt;Kong API Gateway&lt;/b&gt;&lt;br&gt;DB-less&lt;br&gt;&lt;font style='font-size:10px'&gt;single entry point · CORS · rate limits&lt;br&gt;X-Request-ID · blocks /push, /metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="440" y="395" width="190" height="110" as="geometry"/></mxCell><mxCell id="1 s5" value="Public behind Kong (each still checks the app's token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="250" height="560" as="geometry"/></mxCell><mxCell id="1 s6" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reads, login, officer commands&lt;br&gt;uploads (ingestion inside api)&lt;br&gt;WebSocket live updates&lt;br&gt;case match&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="220" width="210" height="120" as="geometry"/></mxCell><mxCell id="1 s7" value="&lt;b&gt;audit-metrics&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;stores every event (audit trail)&lt;br&gt;GET /audit/events · /audit/cases/{id}/cost&lt;br&gt;runs the sweeper (stuck work)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="560" width="210" height="120" as="geometry"/></mxCell><mxCell id="1 s8" value="&lt;b&gt;Pub/Sub topic: domain-events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;one topic · a filtered push subscription per role&lt;br&gt;at-least-once · OIDC-signed pushes&lt;br&gt;5 attempts, then dead-letter&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;direction=south;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="990" y="330" width="230" height="200" as="geometry"/></mxCell><mxCell id="1 s9" value="&lt;b&gt;domain-events-dead-letter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;+ pull subscription to read failures&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;direction=south;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="210" height="80" as="geometry"/></mxCell><mxCell id="1 s10" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;sweep.requested every 2 min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="210" height="60" as="geometry"/></mxCell><mxCell id="1 s11" value="Private workers (only Pub/Sub's identity may invoke)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1270" y="150" width="250" height="590" as="geometry"/></mxCell><mxCell id="1 s12" value="&lt;b&gt;doc-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;OCR · classify · extract&lt;br&gt;(LangGraph, Claude Sonnet/Haiku)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="200" width="210" height="100" as="geometry"/></mxCell><mxCell id="1 s13" value="&lt;b&gt;detection-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;lead agent + 3 specialists&lt;br&gt;10 fraud checks · flags&lt;br&gt;public registry lookups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="370" width="210" height="110" as="geometry"/></mxCell><mxCell id="1 s14" value="&lt;b&gt;case-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;cross-document analysis&lt;br&gt;deterministic risk score · summary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="560" width="210" height="100" as="geometry"/></mxCell><mxCell id="1 s15" value="&lt;b&gt;Supabase Postgres&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;cases · documents · fields&lt;br&gt;flags · runs · audit_events&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="180" width="170" height="110" as="geometry"/></mxCell><mxCell id="1 s16" value="&lt;b&gt;Supabase Storage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;uploaded files (private)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="320" width="170" height="80" as="geometry"/></mxCell><mxCell id="1 s17" value="&lt;b&gt;Supabase Realtime&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;row changes&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1580" y="430" width="170" height="70" as="geometry"/></mxCell><mxCell id="1 s18" value="&lt;b&gt;Anthropic Claude&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sonnet · Haiku&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1580" y="540" width="170" height="70" as="geometry"/></mxCell><mxCell id="1 s19" value="&lt;b&gt;Public registries&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;data.gov.sg · URA · OneMap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1580" y="640" width="170" height="70" as="geometry"/></mxCell><mxCell id="1 s20" value="uses" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 s2" target="1 s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s21" value="HTTPS + WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 s3" target="1 s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s22" value="/cases, /documents, /ws ..." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 s4" target="1 s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s23" value="/audit/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 s4" target="1 s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s24" value="publish commands&lt;br&gt;document.uploaded / approved&lt;br&gt;case.analysis.requested" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 s6" target="1 s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s25" value="push: uploaded, retyped,&lt;br&gt;retry, cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 s8" target="1 s12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s26" value="push: approved,&lt;br&gt;detection retry/cancel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 s8" target="1 s13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s27" value="push: case.analysis.requested" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 s8" target="1 s14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s28" value="push: every event" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="1 s8" target="1 s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s29" value="after 5 failed deliveries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="1 s8" target="1 s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s30" value="sweep tick" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="1 s10" target="1 s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s31" value="status, fields" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="1 s12" target="1 s15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s32" value="agents" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="1 s13" target="1 s18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s33" value="lookups" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="1 s13" target="1 s19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s34" value="runs, risk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="1 s14" target="1 s15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s35" value="change → snapshot pushed&lt;br&gt;to open WebSockets" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;" edge="1" parent="1" source="1 s17" target="1 s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s36" value="store upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="1 s6" target="1 s16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s37" value="&lt;b&gt;How the services talk&lt;/b&gt;&lt;br&gt;• Only through events on one topic, and through Supabase state. No service calls another directly.&lt;br&gt;• Workers publish their own results (document.analyzed, document.detected, case.analysis.completed) back to the topic.&lt;br&gt;• Every event is also an audit row, stored once by audit-metrics (redeliveries ignored by event id).&lt;br&gt;• Status changes are compare-and-swap, so a repeated event can't apply twice.&lt;br&gt;• One codebase, one Dockerfile; ROLE picks what each service runs." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="880" height="130" as="geometry"/></mxCell><mxCell id="1 s38" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1580" y="760" width="210" height="200" as="geometry"/></mxCell><mxCell id="1 s39" value="Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1592" y="790" width="186" height="22" as="geometry"/></mxCell><mxCell id="1 s40" value="Public service (via Kong)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1592" y="817" width="186" height="22" as="geometry"/></mxCell><mxCell id="1 s41" value="Private worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1592" y="844" width="186" height="22" as="geometry"/></mxCell><mxCell id="1 s42" value="Pub/Sub" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;direction=south;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1592" y="871" width="186" height="22" as="geometry"/></mxCell><mxCell id="1 s43" value="Data store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1592" y="898" width="186" height="22" as="geometry"/></mxCell><mxCell id="1 s44" value="Outside service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1592" y="925" width="186" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2-gcp-infrastructure" name="2 GCP infrastructure"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2 g1" value="Infrastructure on Google Cloud (all created by Terraform, deploy/terraform)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="2 g2" value="Management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1180" height="120" as="geometry"/></mxCell><mxCell id="2 g3" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;everything below, state in GCS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="210" height="70" as="geometry"/></mxCell><mxCell id="2 g4" value="&lt;b&gt;Grafana + Managed Prometheus&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;4 dashboards, alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="210" height="70" as="geometry"/></mxCell><mxCell id="2 g5" value="&lt;b&gt;Cloud IAM&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;a service account per service&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="210" height="70" as="geometry"/></mxCell><mxCell id="2 g6" value="&lt;b&gt;Billing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;budget alert · BigQuery export&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="210" height="70" as="geometry"/></mxCell><mxCell id="2 g7" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CI + deploy via Workload&lt;br&gt;Identity Federation (no keys)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1240" y="100" width="210" height="70" as="geometry"/></mxCell><mxCell id="2 g8" value="Loan officers&lt;br&gt;&lt;font style='font-size:10px'&gt;browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="120" height="60" as="geometry"/></mxCell><mxCell id="2 g9" value="Google Cloud Platform · project fyp-six-sevens" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#4285F4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="200" y="220" width="1300" height="820" as="geometry"/></mxCell><mxCell id="2 g10" value="asia-southeast1 (Singapore)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3f8ff;strokeColor=#4285F4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230" y="260" width="1240" height="760" as="geometry"/></mxCell><mxCell id="2 g11" value="Cloud Run (scale to zero; Managed Prometheus sidecar on backend services and Kong)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;da