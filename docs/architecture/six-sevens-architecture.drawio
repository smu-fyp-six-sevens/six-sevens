  <diagram id="4-stuck-work-recovery" name="4 Stuck work recovery">
    <mxGraphModel dx="1624" dy="1608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="920" math="0" shadow="0">
