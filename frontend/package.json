{
  "name": "fyp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.e2e.json",
    "gen:api": "openapi-typescript openapi.json -o src/services/api.gen.ts",
    "check:api": "openapi-typescript openapi.json -o src/services/api.gen.ts --check",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:sprint1": "playwright test --grep @sprint1",
    "test:e2e:sprint2": "playwright test --grep @sprint2",
    "test:e2e:sprint3": "playwright test --grep @sprint3",
    "test:e2e:sprint4": "playwright test --grep @sprint4",
    "test:e2e:sprint5": "playwright test --grep @sprint5"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "openapi-typescript": "7.4.4",
    "typescript": "^5.5.4",
    "vite": "^6.4.3"
  }
}
