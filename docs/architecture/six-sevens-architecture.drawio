          <mxGeometry height="90" width="200" x="580" y="430" as="geometry" />
        </mxCell>
        <mxCell id="4 s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;b&gt;domain-events&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39;&gt;the same topic, not a new one&lt;br&gt;&lt;br&gt;type = recovery.requested&lt;br&gt;&lt;br&gt;subscriptions filter on&lt;br&gt;attribute owner = the worker&lt;br&gt;&lt;br&gt;attempt n of 3,&lt;br&gt;a full limit apart&lt;/font&gt;" vertex="1">
          <mxGeometry height="330" width="180" x="920" y="100" as="geometry" />
