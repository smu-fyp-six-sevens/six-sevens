          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4 s21" edge="1" parent="1" source="4 s14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" target="4 s15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="4 s22" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" value="&lt;b&gt;Also handled&lt;/b&gt;&lt;br&gt;• Worker dies mid-run → its message is never acknowledged, so Pub/Sub redelivers it; after 5 attempts → dead-letter + email alert.&lt;br&gt;• A pod being replaced finishes its current run first (up to 10 minutes&#39; grace) and takes no new events.&lt;br&gt;• Officer cancels a run on another instance → the run polls the audit trail / its status every 5 s and stops.&lt;br&gt;• Publishing an approval fails → the approval is undone and the officer sees an error (nothing left half-done)." vertex="1">
          <mxGeometry height="130" width="1000" x="40" y="770" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
