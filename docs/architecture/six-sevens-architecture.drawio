<mxfile host="app.diagrams.net" type="device"><diagram id="1-system-architecture" name="1 System architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1 s1" value="Six Sevens: event-driven services on GKE Autopilot" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell><mxCell id="1 s2" value="Loan officer&lt;br&gt;&lt;font style='font-size:10px'&gt;browser&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="110" height="70" as="geometry"/></mxCell><mxCell id="1 s3" value="&lt;b&gt;Load balancer + Cloud Armor&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;sixsevens.me · managed TLS&lt;br&gt;OWASP rules · per-address limits&lt;br&gt;(Gateway API)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="200" y="105" width="200" height="140" as="geometry"/></mxCell><mxCell id="1 s4" value="&lt;b&gt;Kong API Gateway&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;CORS · rate limits · request IDs&lt;br&gt;blocks /push and /metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="460" y="100" width="200" height="90" as="geometry"/></mxCell><mxCell id="1 s5" value="&lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;React, served by nginx&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="460" y="210" width="200" height="60" as="geometry"/></mxCell><mxCell id="1 s6" value="Internal services behind Kong (ClusterIP; each checks the app's token)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="560" height="170" as="geometry"/></mxCell><mxCell id="1 s7" value="&lt;b&gt;api&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reads, login, officer commands&lt;br&gt;uploads · WebSocket live updates&lt;br&gt;case match&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="810" y="140" width="240" height="110" as="geometry"/></mxCell><mxCell id="1 s8" value="&lt;b&gt;audit-metrics&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;stores every event in audit_events&lt;br&gt;/audit/events · /audit/cases/{id}/cost&lt;br&gt;runs the sweeper (stuck work)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1090" y="140" width="250" height="110" as="geometry"/></mxCell><mxCell id="1 s9" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;sweep.requested&lt;br&gt;every 5 minutes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1410" y="140" width="190" height="90" as="geometry"/></mxCell><mxCell id="1 s10" value="&lt;b&gt;Pub/Sub topic: domain-events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;one topic · a filtered pull subscription per role · at-least-once delivery · dead letters after 5 tries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="1120" height="70" as="geometry"/></mxCell><mxCell id="1 s11" value="Private workers (no inbound traffic; each pulls its own events)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="580" y="470" width="760" height="180" as="geometry"/></mxCell><mxCell id="1 s12" value="&lt;b&gt;doc-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;OCR · classify · extract&lt;br&gt;LangGraph · Sonnet/Haiku&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="600" y="510" width="220" height="120" as="geometry"/></mxCell><mxCell id="1 s13" value="pull: uploaded, retyped,&lt;br&gt;retry, cancel&lt;br&gt;out: document.analyzed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.2054;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="1 s10" target="1 s12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s14" value="&lt;b&gt;detection-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;lead agent + 3 specialists&lt;br&gt;13 checks · flags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="850" y="510" width="220" height="120" as="geometry"/></mxCell><mxCell id="1 s15" value="pull: approved,&lt;br&gt;retry, cancel&lt;br&gt;out: document.detected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.4286;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="1 s10" target="1 s14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s16" value="&lt;b&gt;case-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;cross-document analysis&lt;br&gt;deterministic risk · summary&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1100" y="510" width="220" height="120" as="geometry"/></mxCell><mxCell id="1 s17" value="pull: analysis requested&lt;br&gt;out: analysis completed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.6518;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="1 s10" target="1 s16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s18" value="&lt;b&gt;domain-events-dead-letter&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;an event lands here after&lt;br&gt;5 failed deliveries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1420" y="480" width="210" height="70" as="geometry"/></mxCell><mxCell id="1 s19" value="&lt;b&gt;Public registries&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;data.gov.sg · URA · OneMap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1420" y="590" width="210" height="70" as="geometry"/></mxCell><mxCell id="1 s20" value="&lt;b&gt;Claude (Anthropic API)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Sonnet and Haiku, called by every worker's agents; the API key is mounted from Secret Manager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="600" y="710" width="720" height="50" as="geometry"/></mxCell><mxCell id="1 s21" value="&lt;b&gt;KEDA&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;scales each worker on&lt;br&gt;its undelivered messages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="1420" y="700" width="210" height="60" as="geometry"/></mxCell><mxCell id="1 s22" value="&lt;b&gt;Supabase&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Postgres: cases, documents, fields,&lt;br&gt;flags, runs, risk, audit_events&lt;br&gt;&lt;br&gt;Storage: uploaded files (private)&lt;br&gt;&lt;br&gt;Realtime: row changes&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="340" height="320" as="geometry"/></mxCell><mxCell id="1 s23" value="HTTPS +&lt;br&gt;WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s2" target="1 s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s24" value="api." style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.2857;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s3" target="1 s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s25" value="sixsevens.me" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.9643;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s3" target="1 s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s26" value="API calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.0455;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s4" target="1 s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s27" value="/audit/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s4" target="1 s8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="80"/><mxPoint x="1215" y="80"/></Array></mxGeometry></mxCell><mxCell id="1 s28" value="commands&lt;br&gt;(uploaded, approved,&lt;br&gt;analysis requested)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.4018;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s7" target="1 s10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s29" value="pull: every event&lt;br&gt;out: recovery.requested" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.6562;exitY=0.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="1 s10" target="1 s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s30" value="scales" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.9444;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s21" target="1 s11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="730"/><mxPoint x="1380" y="640"/></Array></mxGeometry></mxCell><mxCell id="1 s31" value="tick" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.9152;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s9" target="1 s10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.9330;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s10" target="1 s18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.1528;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s12" target="1 s20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s14" target="1 s20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8472;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s16" target="1 s20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s36" value="detection&lt;br&gt;lookups" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1.0000;exitY=0.8611;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="1 s11" target="1 s19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s37" value="reads and writes: status,&lt;br&gt;fields, flags, runs, risk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.7188;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="1 s11" target="1 s22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="1 s38" value="reads and writes ·&lt;br&gt;Realtime → live updates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.0000;exitY=0.8500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;startArrow=block;startFill=1;" edge="1" parent="1" source="1 s7" target="1 s22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="770" y="233.5"/><mxPoint x="770" y="290"/><mxPoint x="210" y="290"/></Array></mxGeometry></mxCell><mxCell id="1 s39" value="&lt;b&gt;How the services talk&lt;/b&gt;&lt;br&gt;• Only through events on one topic, and through Supabase state. No service calls another directly.&lt;br&gt;• Each role pulls only its own events and publishes its result back to the topic; network policies block every other path.&lt;br&gt;• Every event is also an audit row, stored once by audit-metrics (redeliveries ignored by event id).&lt;br&gt;• Status changes are compare-and-swap, so a repeated event can't apply twice.&lt;br&gt;• One codebase, one Dockerfile with a build target per role (shared layers); ROLE picks what each pod runs." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="900" height="140" as="geometry"/></mxCell><mxCell id="1 s40" value="&lt;b&gt;Legend&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1000" y="810" width="420" height="136" as="geometry"/></mxCell><mxCell id="1 s41" value="Front door" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="842" width="190" height="26" as="geometry"/></mxCell><mxCell id="1 s42" value="Internal service (via Kong)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="874" width="190" height="26" as="geometry"/></mxCell><mxCell id="1 s43" value="Private worker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="906" width="190" height="26" as="geometry"/></mxCell><mxCell id="1 s44" value="Pub/Sub topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1210" y="842" width="190" height="26" as="geometry"/></mxCell><mxCell id="1 s45" value="Data store" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1210" y="874" width="190" height="26" as="geometry"/></mxCell><mxCell id="1 s46" value="Outside service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1210" y="906" width="190" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="2-gcp-infrastructure" name="2 GCP infrastructure"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2 g1" value="Infrastructure on Google Cloud (Terraform for the cloud, a Helm chart inside the cluster)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="2 g2" value="Management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;fontStyle=1;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1180" height="120" as="geometry"/></mxCell><mxCell id="2 g3" value="&lt;b&gt;Terraform&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;the cloud pieces, state in GCS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="320" y="100" width="210" height="70" as="geometry"/></mxCell><mxCell id="2 g4" value="&lt;b&gt;Grafana + Managed Prometheus&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;4 dashboards, alerts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="550" y="100" width="210" height="70" as="geometry"/></mxCell><mxCell id="2 g5" value="&lt;b&gt;Cloud Deploy&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;a recorded release per deploy&lt;br&gt;verify · one-step rollback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="780" y="100" width="210" height="70" as="geometry"/></mxCell><mxCell id="2 g6" value="&lt;b&gt;Billing&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;budget alert · BigQuery export&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1010" y="100" width="210" heigh