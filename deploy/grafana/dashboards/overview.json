    {
      "type": "stat",
      "title": "Failed events",
      "description": "Events that failed every delivery attempt in the range. Should be 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pubsub_googleapis_com:subscription_dead_letter_message_count[$__range]))",
