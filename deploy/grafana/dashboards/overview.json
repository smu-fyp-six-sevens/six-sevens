        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "((sum(increase(stage_duration_seconds_count{stage=\"case.analysis.completed\"}[$__range]))) or vector(0))",
          "legendFormat": "__auto",
          "instant": true,
          "range": false
