{
  "name": "product-demo-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "remotion render Master renders/4k/film-4k.mp4 --scale=2 --crf=10 --x264-preset=slow --color-space=bt709 --audio-bitrate=320k",
    "still": "remotion still Master renders/poster.png --frame=150",
    "timing": "node tools/dump-timing.mjs",
    "stills": "node tools/stills.mjs",
    "render:notext": "remotion render Master-NoText renders/4k/film-no-text-4k.mp4 --scale=2 --crf=10 --x264-preset=slow --color-space=bt709 --audio-bitrate=320k",
    "render:preview": "remotion render Master renders/film.mp4 --crf=16 --color-space=bt709 --audio-bitrate=256k",
    "render:novo": "remotion render Master-NoVO renders/4k/film-novo-4k.mp4 --scale=2 --crf=10 --x264-preset=slow --color-space=bt709 --audio-bitrate=320k",
    "vo:fit": "python3 tools/fit-vo.py",
    "render:picture": "remotion render Master-Silent renders/picture.mp4 --muted --color-space=bt709 --crf=16"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "^4.0.532",
    "@remotion/google-fonts": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.532"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "typescript": "5.9.3"
  }
}
