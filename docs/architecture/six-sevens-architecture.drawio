#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="222" as="sourcePoint"/><mxPoint x="1615" y="222" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l12" value="3. publish document.uploaded" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="274" as="sourcePoint"/><mxPoint x="565" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l13" value="4. push (filtered subscription)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="326" as="sourcePoint"/><mxPoint x="775" y="326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l14" value="5. claim queued→processing (compare-and-swap); classify, extract; = analyzed" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="378" as="sourcePoint"/><mxPoint x="1615" y="378" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l15" value="6. publish document.analyzed (+ Claude cost)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="430" as="sourcePoint"/><mxPoint x="565" y="430" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l16" value="7. every event stored once in audit_events" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="482" as="sourcePoint"/><mxPoint x="1405" y="482" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l17" value="8. Realtime change → api pushes a snapshot over the WebSocket" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1615" y="534" as="sourcePoint"/><mxPoint x="145" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l18" value="9. review fields, approve" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="586" as="sourcePoint"/><mxPoint x="355" y="586" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l19" value="10. publish document.approved (undone if the publish fails)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="638" as="sourcePoint"/><mxPoint x="565" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l20" value="11. push" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="690" as="sourcePoint"/><mxPoint x="985" y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l21" value="12. = detecting; lead + specialists + checks; flags; = detected" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="742" as="sourcePoint"/><mxPoint x="1615" y="742" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l22" value="13. publish document.detected (+ Claude cost)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="985" y="794" as="sourcePoint"/><mxPoint x="565" y="794" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l23" value="14. run case analysis" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="846" as="sourcePoint"/><mxPoint x="355" y="846" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l24" value="15. publish case.analysis.requested" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="355" y="898" as="sourcePoint"/><mxPoint x="565" y="898" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l25" value="16. push" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="565" y="950" as="sourcePoint"/><mxPoint x="1195" y="950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l26" value="17. cross-document findings, risk score, summary" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="1002" as="sourcePoint"/><mxPoint x="1615" y="1002" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l27" value="18. publish case.analysis.completed (+ Claude cost)" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1195" y="1054" as="sourcePoint"/><mxPoint x="565" y="1054" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l28" value="19. live update: score and findings appear" style="html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1615" y="1106" as="sourcePoint"/><mxPoint x="145" y="1106" as="targetPoint"/></mxGeometry></mxCell><mxCell id="3 l29" value="One trace in Cloud Trace covers steps 1-6 and 9-13: the traceparent travels on each Pub/Sub message. A worker that dies mid-push is redelivered by Pub/Sub; work stuck past its limit is recovered by the sweeper (page 4)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1180" width="1500" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4-stuck-work-recovery" name="4 Stuck work recovery"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4 s1" value="Recovering stuck work (no database changes; the audit trail is the memory)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="40" as="geometry"/></mxCell><mxCell id="4 s2" value="&lt;b&gt;Cloud Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;every 2 minutes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="170" height="70" as="geometry"/></mxCell><mxCell id="4 s3" value="&lt;b&gt;domain-events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;sweep.requested&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;direction=south;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="270" y="130" width="170" height="90" as="geometry"/></mxCell><mxCell id="4 s4" value="&lt;b&gt;Sweeper&lt;/b&gt; (in audit-metrics)&lt;br&gt;&lt;font style='font-size:10px'&gt;finds work past its limit:&lt;br&gt;queued/uploaded &amp;gt; 5 min (event lost)&lt;br&gt;processing/extracting/detecting &amp;gt; 15 min (run died)&lt;br&gt;case analysis running &amp;gt; 15 min&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="500" y="110" width="260" height="130" as="geometry"/></mxCell><mxCell id="4 s5" value="&lt;b&gt;Supabase&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;documents, runs&lt;br&gt;audit_events (earlier attempts)&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="540" y="320" width="180" height="90" as="geometry"/></mxCell><mxCell id="4 s6" value="&lt;b&gt;domain-events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;recovery.requested&lt;br&gt;attribute owner = worker&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;direction=south;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="830" y="130" width="180" height="90" as="geometry"/></mxCell><mxCell id="4 s7" value="&lt;b&gt;doc-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reset to queued (CAS), rerun&lt;br&gt;after 3 tries: failed → officer can Retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="60" width="260" height="80" as="geometry"/></mxCell><mxCell id="4 s8" value="&lt;b&gt;detection-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;reset to approved (CAS), rerun&lt;br&gt;after 3 tries: approved with error&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="170" width="260" height="80" as="geometry"/></mxCell><mxCell id="4 s9" value="&lt;b&gt;case-worker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;mark the run failed (no rerun:&lt;br&gt;costs Claude calls, officer decides)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1080" y="280" width="260" height="80" as="geometry"/></mxCell><mxCell id="4 s10" value="&lt;b&gt;Outcome events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;document.recovered · recovery.exhausted&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;direction=south;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1080" y="420" width="260" height="70" as="geometry"/></mxCell><mxCell id="4 s11" value="&lt;b&gt;Seen in&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;audit trail · Pipeline dashboard (stuck now,&lt;br&gt;recovered, gave up) · email alert on give-up&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1080" y="540" width="260" height="80" as="geometry"/></mxCell><mxCell id="4 s12" value="publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 s2" target="4 s3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s13" value="push to audit-metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 s3" target="4 s4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s14" value="read only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 s4" target="4 s5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s15" value="publish per stuck item&lt;br&gt;(attempt n, a full limit apart)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 s4" target="4 s6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s16" value="filter: owner = doc-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 s6" target="4 s7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s17" value="filter: owner = detection-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 s6" target="4 s8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s18" value="filter: owner = case-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 s6" target="4 s9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="4 s8" target="4 s10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 s10" target="4 s11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4 s21" value="&lt;b&gt;Also handled&lt;/b&gt;&lt;br&gt;• Worker dies mid-push → Pub/Sub redelivers (ack deadline 600 s); after 5 attempts → dead-letter + email alert.&lt;br&gt;• Officer cancels a run on another instance → the run polls the audit trail / its status every 5 s and stops.&lt;br&gt;• Publishing an approval fails → the approval is undone and the officer sees an error (nothing left half-done)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="960" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="5-observability-and-cost" name="5 Observability and cost"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5 o1" value="Observability: metrics, traces, audit trail and cost" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="40" as="geometry"/></mxCell><mxCell id="5 o2" value="&lt;b&gt;Every backend service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;GET /metrics (prometheus_client)&lt;br&gt;requests · events · stage timings&lt;br&gt;Claude calls/tokens/cost/latency per agent&lt;br&gt;cost per document · tool outcomes · stuck work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="250" height="130" as="geometry"/></mxCell><mxCell id="5 o3" value="&lt;b&gt;Kong&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;status codes, latency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="250" height="60" as="geometry"/></mxCell><mxCell id="5 o4" value="&lt;b&gt;Managed Prometheus sidecar&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;scrapes every 30 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="360" y="180" width="200" height="70" as="geometry"/></mxCell><mxCell id="5 o5" value="&lt;b&gt;Cloud Monitoring&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Managed Prometheus +&lt;br&gt;Cloud Run and Pub/Sub metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="640" y="170" width="210" height="90" as="geometry"/></mxCell><mxCell id="5 o6" value="&lt;b&gt;Cloud Trace&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;one trace per upload, across services&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="210" height="70" as="geometry"/></mxCell><mxCell id="5 o7" value="&lt;b&gt;BigQuery billing export&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;actual invoice lines&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="210" height="70" as="geometry"/></mxCell><mxCell id="5 o8" value="&lt;b&gt;audit_events&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;every action; each run's Claude cost&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="640" y="580" width="210" height="70" as="geometry"/></mxCell><mxCell id="5 o9" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Services · Pipeline · Agents · Cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="230" width="220" height="80" as="geometry"/></mxCell><mxCell id="5 o10" value="&lt;b&gt;Alert policies → email&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;dead letters · 5xx &amp;gt; 5% ·&lt;br&gt;Claude spend/day · recovery gave up&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="960" y="380" width="220" height="80" as="geometry"/></mxCell><mxCell id="5 o11" value="&lt;b&gt;App: Claude Cost tab&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;per case and per document&lt;br&gt;GET /audit/cases/{id}/cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="960" y="580" width="220" height="80" as="geometry"/></mxCell><mxCell id="5 o12" value="scrape" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5 o2" target="5 o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o13" value="scrape" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5 o3" target="5 o4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o14" value="write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5 o4" target="5 o5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o15" value="OpenTelemetry spans" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="5 o2" target="5 o6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o16" value="PromQL (query proxy)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5 o5" target="5 o9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o17" value="SQL (BigQuery plugin)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5 o7" target="5 o9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o18" value="PromQL conditions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5 o5" target="5 o10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="5 o19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="5 o8" target="5 o11"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="6-ci-and-deploy" name="6 CI and deploy"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6 c1" value="Delivery: CI on every push, deploy on demand (GitHub Actions)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="6 c2" value="&lt;b&gt;git push / PR&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="140" height="60" as="geometry"/></mxCell><mxCell id="6 c3" value="&lt;b&gt;CI (ci-cd.yml)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;backend: ruff · pyright (no suppressions) · pytest + coverage&lt;br&gt;frontend: lint · build · Playwright (107 tests)&lt;br&gt;security: Checkov · Snyk or pip-audit + npm audit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="130" width="330" height="120" as="geometry"/></mxCell><mxCell id="6 c4" value="&lt;b&gt;Run workflow&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Deploy to Cloud Run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="140" height="60" as="geometry"/></mxCell><mxCell id="6 c5" value="&lt;b&gt;Authenticate&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Workload Identity Federation&lt;br&gt;one short-lived token per job&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="240" y="360" width="200" height="100" as="geometry"/></mxCell><mxCell id="6 c6" value="&lt;b&gt;Build 8 images&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;one per role + Kong, frontend, Grafana&lt;br&gt;skip if this commit's image exists&lt;br&gt;registry layer cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="500" y="360" width="230" height="100" as="geometry"/></mxCell><mxCell id="6 c7" value="&lt;b&gt;Artifact Registry&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4285F4;" vertex="1" parent="1"><mxGeometry x="790" y="380" width="160" height="60" as="geometry"/></mxCell><mxCell id="6 c8" value="&lt;b&gt;Roll out&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;workers first, then api, Kong, frontend&lt;br&gt;traffic → newest revision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1010" y="360" width="230" height="100" as="geometry"/></mxCell><mxCell id="6 c9" value="&lt;b&gt;Gateway check&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;/health ok · /cases 401 · /push 404&lt;br&gt;worker 403 · CORS · frontend · Grafana&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1300" y="360" width="230" height="100" as="geometry"/></mxCell><mxCell id="6 c10" value="&lt;b&gt;Done&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;summary with URLs&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1590" y="300" width="150" height="60" as="geometry"/></mxCell><mxCell id="6 c11" value="&lt;b&gt;Roll back every service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;to the revision serving before&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1590" y="450" width="170" height="70" as="geometry"/></mxCell><mxCell id="6 c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6 c2" target="6 c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6 c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6 c4" target="6 c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6 c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6 c5" target="6 c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6 c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6 c6" target="6 c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6 c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6 c7" target="6 c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6 c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6 c8" target="6 c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6 c18" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6 c9" target="6 c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6 c19" value="fail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="6 c9" target="6 c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6 c20" value="Terraform owns configuration (sizes, scaling, env, secrets, IAM); the deploy workflow only changes images." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="560" width="900" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
